# The Guild embeds third-party submissions, so it is worth being explicit about
# what this origin will and will not do.
#
# `frame-src` pins framing to the apps origin: the one iframe on the site is the
# only frame that should ever load, and anything injected pointing elsewhere is
# refused. `frame-ancestors 'none'` is the mirror of that — the Guild itself is
# never to be embedded in someone else's page.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: frame-src https://vibe-guild-apps.moneytalkwithmalik.workers.dev; frame-ancestors 'none'; base-uri 'none'; object-src 'none'
