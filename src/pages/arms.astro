---
import Hall from '../layouts/Hall.astro';
import Crest from '../components/Crest.astro';
import { CHARGE_NAMES, DIVISIONS, blazon } from '../lib/crest';

// A reference page for the generator: enough usernames to see the whole range
// at once, so a bad combination has nowhere to hide.
const sample = [
  'malik', 'ada', 'grim', 'nova', 'pixelwitch', 'orbital', 'runa', 'kestrel',
  'foxglove', 'mono', 'harbour', 'sable', 'quill', 'tinker', 'vesper', 'atlas',
  'brack', 'cinder', 'delve', 'ember', 'flint', 'gale', 'hollow', 'iris',
  'juniper', 'kiln', 'lumen', 'marrow', 'nettle', 'onyx', 'plume', 'quarry',
];
---

<Hall title="Crests" description="How every member's crest is made — drawn from their username, with real heraldry rules behind it.">
  <section class="top rise">
    <p class="mark">Reference</p>
    <h1>Crests</h1>
    <p class="lede">
      Every member's crest is drawn from their username alone, so the same
      username always gives the same crest. Heraldry sorts its eight colours
      into two families — the metals, gold and silver, and the colours — and
      never sets one on its own kind. These keep that rule, which is what makes
      them look like real coats of arms rather than random shapes.
    </p>
    <p class="lede">
      The italic line under each shield is its blazon: the wording heralds have
      always used to describe a coat of arms. That is generated too, so nobody
      has to write one.
    </p>
    <p class="mark">
      {DIVISIONS.length} shield patterns × {CHARGE_NAMES.length} symbols × 8 colours
    </p>
  </section>

  <ul class="sheet">
    {sample.map((h) => (
      <li>
        <Crest handle={h} size={82} title={false} />
        <strong>{h}</strong>
        <span>{blazon(h).text}</span>
      </li>
    ))}
  </ul>
</Hall>

<style>
  .top { padding: clamp(2rem, 6vw, 4rem) 0 2.4rem; }
  .top > * + * { margin-top: 0.7rem; }
  .sheet {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(168px, 1fr));
    gap: 1.6rem 1rem;
  }
  .sheet li {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    text-align: center;
  }
  /*
   * Ink, not brass. The brass and vellum tokens are built for the dark timber
   * ground; used unguarded on a parchment sheet they invert. Measured on
   * #f4e8cf: --brass-lit is 1.26:1 and the old rgba(242,229,203,.5) blazon was
   * lighter than the paper under it. These are 14.1:1 and 7.7:1.
   */
  .sheet strong {
    font-family: var(--mark);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .sheet span {
    font-size: 0.74rem;
    font-style: italic;
    color: var(--ink-soft);
    line-height: 1.4;
  }
</style>
