---
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import Hall from '../../layouts/Hall.astro';
import Crest from '../../components/Crest.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);

const authors = await Promise.all(d.by.map((ref: any) => getEntry(ref)));

/**
 * Submitted work is served from its own origin (see tools/serve-apps.mjs).
 * That is what lets the frame carry `allow-same-origin` safely: "same origin"
 * there means the app's, not this site's, so the app keeps its own storage and
 * loads its own modules while still being unable to reach anything of ours.
 * With no separate origin configured we fall back to same-origin serving and
 * drop that permission, which is safe but costs the app its storage.
 */
const appsOrigin = import.meta.env.PUBLIC_APPS_ORIGIN ?? '';
const isolated = appsOrigin !== '';
// The apps host is rooted at the apps/ folder itself, so the `/apps` prefix is
// only needed in the fallback where this site serves them. Point at the
// directory rather than index.html: both the local apps server and Cloudflare's
// asset handler resolve it, and naming the file earns a 307 redirect first.
const src = d.play.bundle
  ? `${appsOrigin}${isolated ? '' : '/apps'}/${d.play.bundle}/`
  : d.play.url;
const sandbox = [
  'allow-scripts',
  'allow-pointer-lock',
  'allow-popups',
  'allow-downloads',
  ...(isolated || d.play.url ? ['allow-same-origin'] : []),
].join(' ');
/**
 * Whether the work is reachable somewhere other than this site's own origin,
 * which is the condition for offering to open it top-level. In the same-origin
 * dev fallback that offer would hand a submission this site's own storage and
 * service-worker scope — the very thing the two-origin split exists to prevent.
 */
const offSite = isolated || !!d.play.url;
const posted = d.posted.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
});
// Licences are given as identifiers ("MIT", "Apache-2.0"), which read as an
// unlabelled code beside a code link unless something says what they are. The
// label does that now, so a value carrying the word as well would say it twice.
const licence = d.license.replace(/\s*licen[cs]e\s*$/i, '');
---

<Hall title={d.title} description={d.tagline}>
  <article class="commission">
    <header class="head">
      <div class="head__text">
        <p class="mark">{d.kind === 'game' ? 'A game' : 'An app'} · posted {posted}</p>
        <h1>{d.title}</h1>
        <p class="lede">{d.tagline}</p>

        <div class="by">
          <span class="mark">Made by</span>
          {authors.map((a: any) => (
            <a class="by__one" href={`/creators/${a.id}`}>
              <Crest handle={a.id} size={34} title={false} />
              <span>{a.data.name}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="head__meta">
        {d.tags.length > 0 && (
          <div class="tags">
            {d.tags.map((t: string) => (
              <a class="chip" href={`/projects?tag=${encodeURIComponent(t)}`}>{t}</a>
            ))}
          </div>
        )}
        <p class="fact"><span class="mark">Licence</span><span class="fact__v">{licence}</span></p>
        {d.source && <a class="btn btn--ghost" href={d.source}>See the code ↗</a>}
      </div>
    </header>

    <!--
      Third-party code runs here. `allow-same-origin` is granted only because
      the bundle is served from a different host: it resolves to the apps
      origin, which holds nothing but static submissions, so the frame keeps
      real storage and module loading while still being unable to reach this
      page. Without a separate origin configured the permission is dropped
      instead — safe, but the submission loses its storage.
    -->
    <figure class="stage frame" style={`--aspect:${d.play.aspect}`} data-stage>
      {d.play.desktopOnly && (
        <p class="stage__note">
          <span class="mark">Needs a keyboard</span>
          This one still loads below, but you need a computer with a keyboard and mouse to play it.
        </p>
      )}

      <div class="stage__well">
        <!--
          The `onload` mark is here rather than only in the script below because
          the parser may yield between this element and that script, letting a
          warm-cache `load` fire before any listener exists. Recorded on the
          element itself, that arrival cannot be missed.
        -->
        <iframe
          src={src}
          title={`${d.title} — playable`}
          sandbox={sandbox}
          allow="autoplay; gamepad; fullscreen; xr-spatial-tracking"
          loading="lazy"
          referrerpolicy="no-referrer"
          onload="this.dataset.arrived = ''"
        ></iframe>

        <!--
          The frame is a black rectangle until the submission's own first paint,
          which for a multi-megabyte build is seconds of nothing. This cover
          stands in front of it until then. It is shown by the script below and
          by nothing else, so with JS off it never appears and the frame is
          simply itself.
        -->
        <div class="veil" role="status">
          <div class="veil__wait">
            <div class="veil__arms" aria-hidden="true">
              <Crest handle={authors[0].id} size={58} title={false} />
            </div>
            <p class="mark">Loading</p>
            <p class="veil__say">
              {d.title} is starting up. The whole thing is downloaded the first
              time you open it, so give it a moment.
            </p>
            <div class="veil__bar" aria-hidden="true"><span></span></div>
            <p class="veil__slow">Still going — a big project takes a while on a slow connection.</p>
          </div>

          <div class="veil__fail">
            <p class="mark veil__cue--bad">This did not load</p>
            <p class="veil__say">
              Nothing arrived. The project may be offline, or your browser may
              be blocking it.
            </p>
            <div class="veil__acts">
              <button class="btn btn--ghost" type="button" data-retry>Try again</button>
              {offSite && (
                <a class="btn btn--ghost" href={src} target="_blank" rel="noreferrer">
                  Open it in a new tab ↗
                </a>
              )}
            </div>
          </div>
        </div>
      </div>

      <figcaption class="stage__bar">
        <p class="vouch">
          <svg class="vouch__shield" viewBox="0 0 100 116" width="14" height="16" aria-hidden="true">
            <path
              d="M3 3H97v53c0 31-24 49-47 57C27 105 3 87 3 56Z"
              fill="rgba(192,138,52,0.16)"
              stroke="#c08a34"
              stroke-width="7"
            />
          </svg>
          {isolated ? (
            <>
              <span class="mark vouch__cue">Safe to play</span>
              <span class="vouch__say">
                Someone else's code runs here, so we keep it boxed in. It loads
                from a separate web address of its own and is locked inside this
                frame, so it cannot reach this page, the rest of the site, or you.
              </span>
            </>
          ) : (
            <>
              <span class="mark vouch__cue">Not split off yet</span>
              <span class="vouch__say">
                This copy is served from the site's own web address. Run
                <code>npm run apps</code> to give projects the separate address
                they get on the live site.
              </span>
            </>
          )}
        </p>

        <span class="stage__acts">
          {offSite && (
            <a class="chip" href={src} target="_blank" rel="noreferrer">New tab ↗</a>
          )}
          {d.play.fullscreen && (
            <button class="chip" type="button" data-fullscreen hidden>Fullscreen</button>
          )}
        </span>
      </figcaption>
    </figure>

    <script is:inline>
      (() => {
        const stage = document.querySelector('[data-stage]');
        const frame = stage && stage.querySelector('iframe');
        if (!frame) return;
        const src = frame.getAttribute('src');

        let timers = [];
        const stop = () => { timers.forEach(clearTimeout); timers = []; };
        const set = (state) => { stage.dataset.state = state; };

        /*
         * `loading="lazy"` means the fetch may not have started yet, so the
         * clock that eventually calls this a failure only starts once the frame
         * nears the viewport. Otherwise a stage below a long page would report
         * a failure the browser had not yet attempted.
         */
        const clock = () => {
          stop();
          timers.push(setTimeout(() => {
            if (stage.dataset.state === 'loading') set('slow');
          }, 7000));
          timers.push(setTimeout(() => {
            if (stage.dataset.state !== 'ready') set('failed');
          }, 30000));
        };

        frame.addEventListener('load', () => { stop(); set('ready'); });
        frame.addEventListener('error', () => { stop(); set('failed'); });

        /*
         * A frame that already arrived is never put behind the cover: the
         * `onload` mark on the element catches the load this script was too
         * late to hear, which otherwise ends with a failure panel standing over
         * a working game.
         */
        if ('arrived' in frame.dataset) {
          set('ready');
        } else {
          set('loading');
          if ('IntersectionObserver' in window) {
            const io = new IntersectionObserver((entries) => {
              if (entries.some((e) => e.isIntersecting)) { io.disconnect(); clock(); }
            }, { rootMargin: '250px' });
            io.observe(frame);
          } else {
            clock();
          }
        }

        const retry = stage.querySelector('[data-retry]');
        if (retry) {
          retry.addEventListener('click', () => {
            set('loading');
            clock();
            /*
             * Set, never cleared first. Removing the attribute is not a neutral
             * reset: it navigates the frame to about:blank, and that navigation
             * fires a `load` this would read as the submission having arrived,
             * clearing the cover off an empty frame. Setting `src` is itself
             * what re-runs the frame's navigation, same value or not.
             */
            frame.setAttribute('src', src);
          });
        }

        // Ships hidden: where fullscreen is unsupported or disallowed by policy
        // — and with JS off — the control would be a button that does nothing.
        const full = stage.querySelector('[data-fullscreen]');
        if (full && frame.requestFullscreen && document.fullscreenEnabled) {
          full.hidden = false;
          // A refusal is the browser answering the user, not a fault to log.
          full.addEventListener('click', () => frame.requestFullscreen().catch(() => {}));
        }
      })();
    </script>

    <div class="sheet leaf illuminate prose">
      <Content />
    </div>

    {d.shots.length > 0 && (
      <section class="shots">
        {d.shots.map((s: any) => (
          <Image src={s} alt={`${d.title} screenshot`} width={900} height={560} loading="lazy" />
        ))}
      </section>
    )}
  </article>
</Hall>

<style>
  .commission { padding: clamp(1.6rem, 5vw, 3.2rem) 0 0; }

  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.6rem;
    align-items: end;
    margin-bottom: 1.8rem;
  }
  .head__text > * + * { margin-top: 0.7rem; }
  .head__meta { display: grid; gap: 0.9rem; justify-items: end; }

  .by { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem; padding-top: 0.4rem; }
  /*
   * Without a label the crests read as ornament rather than attribution. It
   * keeps `.mark`'s brass rather than being dimmed to sit back — `--brass-dim`
   * is 2.9:1 on the wall, and this is 11px text that has to be read.
   */
  .by__one {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--vellum);
    font-family: var(--carve);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
  }
  .by__one:hover { color: var(--brass-lit); }

  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: flex-end; }

  .fact {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    margin: 0;
    max-width: none;
  }
  .fact__v { font-size: 0.92rem; color: rgba(244, 232, 207, 0.78); }

  /* --------------------------------------------------------------------------
     The stage: a cabinet the work sits inside, not a bordered div. Timber
     surround with the grain running through it, a brass lip, and the picture
     recessed behind that lip so it reads as set back into the case.
     -------------------------------------------------------------------------- */
  .stage {
    margin: 0;
    padding: clamp(11px, 1.3vw, 20px);
    background-color: #241708;
    background-image:
      /* candles above the hall catching the top of the case */
      linear-gradient(180deg, rgba(255, 198, 112, 0.13), transparent 34%),
      repeating-linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.24) 0 2px,
        transparent 2px 84px,
        rgba(0, 0, 0, 0.16) 84px 86px
      ),
      repeating-linear-gradient(
        92deg,
        rgba(0, 0, 0, 0.11) 0 4px,
        transparent 4px 11px,
        rgba(255, 214, 160, 0.02) 11px 13px
      ),
      linear-gradient(168deg, var(--oak-lit) 0%, var(--oak) 54%, #150e07 100%);
  }
  /*
   * The bevel on the case itself: a lit top edge, a dark foot. Kept as an inset
   * shadow so it follows the surround rather than needing another element, and
   * appended to the hanging shadow `.frame` already casts.
   */
  .stage.frame {
    box-shadow:
      var(--shadow-hang),
      0 0 0 1px rgba(0, 0, 0, 0.55) inset,
      0 1px 0 rgba(240, 205, 133, 0.22) inset,
      0 -14px 26px -20px rgba(0, 0, 0, 0.9) inset;
  }

  .stage__well {
    position: relative;
    overflow: hidden;
    background: #070503;
    /* the brass lip, outside the picture */
    box-shadow: 0 0 0 1px rgba(192, 138, 52, 0.4);
  }
  /*
   * The recess. Inset shadows on the well itself would paint under the iframe
   * and never be seen, so the shading that sets the picture back into the case
   * has to sit in front of it — hence an overlay that takes no pointer events.
   */
  .stage__well::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.6) inset,
      0 16px 22px -16px rgba(0, 0, 0, 0.92) inset,
      0 -12px 20px -16px rgba(0, 0, 0, 0.75) inset;
  }

  .stage iframe {
    display: block;
    width: 100%;
    aspect-ratio: var(--aspect, 16 / 9);
    border: 0;
    background: #070503;
  }

  /*
   * Only shown where it is true: on a wide screen the frame speaks for itself,
   * and a standing "you need a keyboard" notice would just be noise. It hangs
   * on the case above the picture, so it reads as a placard on this cabinet
   * rather than a loose warning strip in the page.
   */
  .stage__note {
    display: none;
    margin: 0 0 clamp(9px, 1.1vw, 14px);
    max-width: none;
    padding: 0.6rem 0.8rem;
    border-left: 3px solid rgba(192, 138, 52, 0.75);
    background: rgba(194, 145, 63, 0.1);
    color: rgba(244, 232, 207, 0.86);
    font-family: var(--mark);
    font-size: 0.76rem;
    line-height: 1.6;
  }
  /*
   * The placard hangs at the top of the case, where the candle wash lifts the
   * timber to about rgb(95,68,37) — and against that, --brass measures 3.0:1 at
   * 11px. The lit tone reads as the same metal catching the same light and
   * lands at 5.9:1.
   */
  .stage__note .mark { display: block; color: var(--brass-lit); }
  @media (max-width: 760px), (pointer: coarse) {
    .stage__note { display: block; }
  }

  /* --- the cover over a submission that has not loaded ------------------- */

  .veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-content: center;
    /*
     * The well takes its height from the frame's aspect, so it does not grow
     * with these words: on a phone the failure panel — cue, sentence and two
     * buttons — stands taller than the picture, as does any state at a large
     * type size. Overflow scrolls instead of being cropped by the picture's
     * edge, and `safe` keeps the head of it reachable when that happens. The
     * `place-content` above remains the fallback where the keyword is unknown.
     */
    align-content: safe center;
    overflow-y: auto;
    justify-items: center;
    padding: clamp(1rem, 3vw, 2rem);
    text-align: center;
    background:
      radial-gradient(120% 100% at 50% 0%, rgba(255, 198, 112, 0.1), transparent 62%),
      linear-gradient(180deg, #16100a, #070503);
    /* Hidden until the script shows it, so a JS-less visitor is never left
       staring at a cover nothing can lift. */
    opacity: 0;
    visibility: hidden;
    transition: opacity 380ms ease, visibility 380ms;
  }
  .stage[data-state='loading'] .veil,
  .stage[data-state='slow'] .veil,
  .stage[data-state='failed'] .veil { opacity: 1; visibility: visible; }

  .veil__wait, .veil__fail { display: grid; justify-items: center; gap: 0.7rem; }
  .veil__fail, .veil__slow { display: none; }
  .stage[data-state='slow'] .veil__slow { display: block; }
  .stage[data-state='failed'] .veil__wait { display: none; }
  .stage[data-state='failed'] .veil__fail { display: grid; }

  .veil__arms { opacity: 0.5; }
  /*
   * Wax lightened towards parchment rather than `--wax-lit` itself, which is
   * 3.8:1 on this near-black ground and this line is 11px mono. Lifted it lands
   * near 7:1 and still reads as wax caught by candlelight, not as an error red.
   */
  .veil__cue--bad { color: #d38670; }
  /* Every line here is a paragraph, and the global trailing 1em would open a
     gap the grid is already spacing — inside a box that cannot grow to take it. */
  .veil p { margin: 0; }
  .veil__say {
    max-width: 46ch;
    font-size: 0.95rem;
    line-height: 1.55;
    color: rgba(244, 232, 207, 0.78);
  }
  .veil__slow {
    max-width: 46ch;
    font-family: var(--mark);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: rgba(244, 232, 207, 0.56);
  }
  .veil__acts { display: flex; flex-wrap: wrap; gap: 0.7rem; justify-content: center; }

  /* An indeterminate sweep, because the real figure is unknowable from here:
     a cross-origin frame reports no progress. */
  .veil__bar {
    width: min(230px, 62%);
    height: 2px;
    overflow: hidden;
    background: rgba(192, 138, 52, 0.2);
  }
  .veil__bar span {
    display: block;
    width: 40%;
    height: 100%;
    background: linear-gradient(90deg, transparent, var(--brass-lit), transparent);
    animation: sweep 1500ms ease-in-out infinite;
  }
  @keyframes sweep {
    from { transform: translateX(-105%); }
    to { transform: translateX(320%); }
  }
  /* The bar's only content is its motion, so stopped it is a stray brass line —
     the words already say what it was saying. */
  @media (prefers-reduced-motion: reduce) {
    .veil__bar { display: none; }
  }

  /* --- the plate under the picture --------------------------------------- */

  .stage__bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: clamp(0.8rem, 2vw, 1.8rem);
    padding: 0.75rem 0.15rem 0.1rem;
  }
  /*
   * This line is the site's strongest engineering claim, so it is set in the
   * reading face rather than in metadata mono — uppercase mono at caption size
   * reads as a technical footnote whatever it says.
   */
  .vouch {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.6rem;
    margin: 0;
    max-width: 82ch;
  }
  .vouch__shield { flex: none; transform: translateY(2px); }
  .vouch__cue { color: var(--brass-lit); }
  .vouch__say {
    font-size: 0.88rem;
    line-height: 1.5;
    color: rgba(244, 232, 207, 0.74);
  }
  .vouch__say code {
    font-family: var(--mark);
    font-size: 0.82em;
    padding: 0.05em 0.3em;
    background: rgba(192, 138, 52, 0.14);
    color: var(--brass-lit);
  }

  .stage__acts { display: flex; align-items: center; gap: 0.5rem; flex: none; }
  .stage__acts .chip { cursor: pointer; font-family: var(--mark); }

  .prose { margin: 2.6rem 0; transform: rotate(-0.25deg); }
  .prose :global(ul) { padding-left: 1.15rem; }
  .prose :global(li) { margin-bottom: 0.38rem; color: var(--ink-soft); }

  .shots { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }
  .shots :global(img) { border: 1px solid rgba(194, 145, 63, 0.24); }

  @media (max-width: 760px) {
    .head { grid-template-columns: 1fr; align-items: start; }
    .head__meta { justify-items: start; }
    .tags { justify-content: flex-start; }
    /* Stacked, the plate's sentence needs the full width and the controls read
       better as a row beneath it than as a squeezed column beside it. */
    .stage__bar { flex-direction: column; align-items: stretch; }
    /*
     * A 16:9 well is only about 170px tall on a 360px phone. The arms go, the
     * copy tightens and the controls shrink so that the waiting state — the one
     * nearly every visitor sees — sits inside the picture. The failure panel's
     * two buttons still exceed it on the narrowest phones; that is what the
     * cover's own scroller is for.
     */
    .veil { padding: 0.9rem; }
    .veil__arms { display: none; }
    .veil__wait, .veil__fail { gap: 0.55rem; }
    .veil__say { font-size: 0.86rem; }
    .veil__acts .btn { padding: 0.5rem 0.85rem; font-size: 0.72rem; letter-spacing: 0.1em; }
  }
</style>
