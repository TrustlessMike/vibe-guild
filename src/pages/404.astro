---
/**
 * Cloudflare's asset handler is configured with `not_found_handling: "404-page"`,
 * which serves this file's build output for anything unmatched. Without it an
 * unknown URL returns an empty body.
 */
import Hall from '../layouts/Hall.astro';
---

<Hall title="Not on the board" description="No such commission.">
  <section class="lost">
    <div class="sheet leaf">
      <p class="mark">Notice</p>
      <h1>No such commission</h1>
      <p>
        Nothing is posted at this address. It may have been taken down, or the
        board may never have carried it at all.
      </p>
      <div class="lost__acts">
        <a class="btn" href="/projects">See the board</a>
        <a class="btn btn--ghost" href="/">Back to the hall</a>
      </div>
    </div>
  </section>
</Hall>

<style>
  .lost {
    display: grid;
    place-items: center;
    min-height: 58vh;
    padding: clamp(2rem, 6vw, 4rem) 0;
  }
  .lost .sheet {
    max-width: 34rem;
    text-align: center;
    transform: rotate(-0.4deg);
  }
  /* The global display size is set for full-width mastheads and runs past the
     edge of a 34rem sheet — "commission" is one long unbreakable word. */
  .lost h1 {
    margin: 0.5rem 0 0.9rem;
    font-size: clamp(1.75rem, 5.2vw, 2.5rem);
    line-height: 1.06;
    overflow-wrap: break-word;
  }
  .lost p { color: var(--ink-soft); }
  .lost__acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    justify-content: center;
    margin-top: 1.6rem;
  }
</style>
