---
import '../styles/guild.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const {
  title,
  description = 'A guild hall for people who make things. Games and apps by independent creators — free, open source, and playable right here.',
  wide = false,
} = Astro.props;

const nav = [
  { href: '/projects', label: 'The Board' },
  { href: '/creators', label: 'The Roster' },
  { href: '/submit', label: 'Post a Commission' },
];
const path = Astro.url.pathname;

// Absolute URLs, because og:image and og:url are not resolved relative to the
// page by the services that read them — a relative path just yields no card.
const canonical = new URL(path, Astro.site ?? 'https://vibe-guild.moneytalkwithmalik.workers.dev');
const ogImage = new URL('/og.png', Astro.site ?? 'https://vibe-guild.moneytalkwithmalik.workers.dev');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · The Vibe Guild</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} · The Vibe Guild`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Vibe Guild" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Vibe Guild — a hall for people who make things" />
    <!-- Without summary_large_image the card renders as a thumbnail strip. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · The Vibe Guild`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 116'%3E%3Cpath d='M3 3H97v53c0 31-24 49-47 57C27 105 3 87 3 56Z' fill='%238f2f22' stroke='%23c2913f' stroke-width='6'/%3E%3Cpath d='M50 18l8 25h26L63 58l8 25-21-15-21 15 8-25-21-15h26z' fill='%23c2913f'/%3E%3C/svg%3E"
    />
  </head>

  <body>
    <header class="topbar">
      <div class="hall topbar__in">
        <a href="/" class="brand" aria-label="The Vibe Guild, home">
          <svg viewBox="0 0 100 116" width="26" height="30" aria-hidden="true" class="brand__shield">
            <path d="M3 3H97v53c0 31-24 49-47 57C27 105 3 87 3 56Z" fill="#8f2f22" stroke="#c2913f" stroke-width="6" />
            <path d="M50 18l8 25h26L63 58l8 25-21-15-21 15 8-25-21-15h26z" fill="#c2913f" />
          </svg>
          <span class="brand__word">The Vibe Guild</span>
        </a>

        <nav class="nav" aria-label="Primary">
          {nav.map((n) => (
            <a
              href={n.href}
              class="nav__link"
              aria-current={path.startsWith(n.href) ? 'page' : undefined}
            >
              {n.label}
            </a>
          ))}
          <a class="nav__link nav__link--out" href="https://github.com/TrustlessMike/vibe-guild">
            GitHub ↗
          </a>
        </nav>
      </div>
    </header>

    <main class={wide ? '' : 'hall'}>
      <slot />
    </main>

    <footer class="foot">
      <div class="hall">
        <div class="foot__sheet sheet">
          <span class="pin" aria-hidden="true"></span>
          <p class="mark">The oath of the hall</p>
          <p class="foot__oath">
            The Guild takes no cut, hosts no adverts and owns nothing you make.
            Every member and every commission on this board is a file in a public
            repository — fork it, host your own hall, take the whole thing with you.
          </p>
          <p class="mark">Free &amp; open source · MIT</p>
        </div>
      </div>
    </footer>

    <style>
      /* A carved beam across the top of the hall: timber, an iron underside
         and a brass edge catching the candles. */
      .topbar {
        position: sticky;
        top: 0;
        z-index: 50;
        background-color: #2b1d11;
        background-image:
          radial-gradient(60% 180% at 12% 50%, rgba(255, 196, 112, 0.16), transparent 70%),
          radial-gradient(50% 160% at 78% 50%, rgba(255, 186, 104, 0.11), transparent 72%),
          repeating-linear-gradient(90deg,
            rgba(0,0,0,.22) 0 2px, transparent 2px 96px, rgba(0,0,0,.14) 96px 98px),
          repeating-linear-gradient(92deg,
            rgba(0,0,0,.1) 0 4px, transparent 4px 11px, rgba(255,214,160,.02) 11px 13px),
          linear-gradient(180deg, #3a2716 0%, #2b1d11 62%, #170f08 100%);
        border-bottom: 2px solid rgba(0, 0, 0, 0.7);
        box-shadow:
          0 1px 0 rgba(240, 205, 133, 0.28) inset,
          0 14px 30px -12px rgba(0, 0, 0, 0.85);
      }
      .topbar::after {
        content: '';
        position: absolute;
        left: 0; right: 0; bottom: -2px;
        height: 2px;
        background: linear-gradient(90deg, transparent, rgba(192,138,52,.75) 12%, rgba(240,205,133,.9) 50%, rgba(192,138,52,.75) 88%, transparent);
      }
      .topbar__in {
        display: flex; align-items: center; justify-content: space-between;
        gap: 1.5rem; padding: 0.95rem 0;
      }
      .brand { display: inline-flex; align-items: center; gap: 0.7rem; text-decoration: none; color: var(--vellum); }
      .brand__shield { filter: drop-shadow(0 3px 7px rgba(0,0,0,.75)); }
      .brand__word {
        font-family: var(--carve); font-weight: 800; font-size: 1.02rem;
        letter-spacing: 0.19em; text-transform: uppercase;
        text-shadow: 0 2px 3px rgba(0,0,0,.8);
      }
      .nav { display: flex; align-items: center; gap: clamp(0.7rem, 2vw, 1.8rem); flex-wrap: wrap; }
      .nav__link {
        font-family: var(--mark); font-size: 0.71rem; letter-spacing: 0.16em;
        text-transform: uppercase; color: rgba(244, 232, 207, 0.62);
        text-decoration: none; padding: 0.32rem 0;
        border-bottom: 1px solid transparent; white-space: nowrap;
        text-shadow: 0 1px 2px rgba(0,0,0,.7);
      }
      .nav__link:hover { color: var(--brass-hi); border-bottom-color: rgba(192,138,52,.6); }
      .nav__link[aria-current='page'] { color: var(--brass-lit); border-bottom-color: var(--brass); }
      .nav__link--out { color: rgba(244, 232, 207, 0.38); }

      /* The oath, on parchment nailed to the wall at the end of the hall. */
      .foot { margin-top: clamp(4rem, 10vw, 8rem); padding: 0 0 4rem; }
      .foot__sheet {
        max-width: 64ch;
        margin-inline: auto;
        padding: 2rem 2.2rem 2.2rem;
        text-align: center;
        transform: rotate(-0.35deg);
      }
      .foot__oath { margin: 0 auto 0.9rem; color: var(--ink-soft); font-size: 0.97rem; }
      @media (max-width: 640px) {
        .topbar__in { flex-direction: column; align-items: flex-start; gap: 0.55rem; }
      }
    </style>
  </body>
</html>
