---
import '../styles/guild.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const {
  title,
  description = 'A site for people who make things. Games and apps by independent creators — free, open source, and playable right here.',
  wide = false,
} = Astro.props;

const nav = [
  { href: '/projects', label: 'Projects' },
  { href: '/creators', label: 'Members' },
  { href: '/submit', label: 'Submit your work' },
];
const path = Astro.url.pathname;

// Absolute URLs, because og:image and og:url are not resolved relative to the
// page by the services that read them — a relative path just yields no card.
const canonical = new URL(path, Astro.site ?? 'https://vibe-guild.moneytalkwithmalik.workers.dev');
const ogImage = new URL('/og.png', Astro.site ?? 'https://vibe-guild.moneytalkwithmalik.workers.dev');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · The Vibe Guild</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} · The Vibe Guild`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Vibe Guild" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Vibe Guild — a site for people who make things" />
    <!-- Without summary_large_image the card renders as a thumbnail strip. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · The Vibe Guild`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 116'%3E%3Cpath d='M3 3H97v53c0 31-24 49-47 57C27 105 3 87 3 56Z' fill='%238f2f22' stroke='%23c2913f' stroke-width='6'/%3E%3Cpath d='M50 18l8 25h26L63 58l8 25-21-15-21 15 8-25-21-15h26z' fill='%23c2913f'/%3E%3C/svg%3E"
    />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <!-- Watched instead of the scroll position, so the beam's shadow costs no
         scroll handler. -->
    <div class="beam-mark" aria-hidden="true"></div>

    <header class="topbar">
      <div class="hall topbar__in">
        <a href="/" class="brand" aria-label="The Vibe Guild, home">
          <svg viewBox="0 0 100 116" width="26" height="30" aria-hidden="true" class="brand__shield">
            <path d="M3 3H97v53c0 31-24 49-47 57C27 105 3 87 3 56Z" fill="#8f2f22" stroke="#c2913f" stroke-width="6" />
            <path d="M50 18l8 25h26L63 58l8 25-21-15-21 15 8-25-21-15h26z" fill="#c2913f" />
          </svg>
          <span class="brand__word">The Vibe Guild</span>
        </a>

        <nav class="nav" aria-label="Primary">
          {nav.map((n) => (
            <a
              href={n.href}
              class="nav__link"
              aria-current={path.startsWith(n.href) ? 'page' : undefined}
            >
              {n.label}
            </a>
          ))}
          <a class="nav__link nav__link--out" href="https://github.com/TrustlessMike/vibe-guild">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </header>

    <!-- Focusable, or the skip link only scrolls and leaves focus in the beam —
         which is no use to the one person who pressed it. -->
    {/* class:list rather than a ternary. Astro appends its scope hash to
        whatever the expression yields, so a bare `undefined` ships as a literal
        class the day a page first passes wide. Written in a JSX comment because
        an HTML comment would be emitted onto every page in the site. */}
    <main id="main" tabindex="-1" class:list={[!wide && 'hall']}>
      <slot />
    </main>

    <footer class="foot">
      <div class="hall">
        <div class="foot__sheet sheet">
          <span class="pin" aria-hidden="true"></span>
          <p class="mark">What we promise</p>
          <p class="foot__oath">
            We take no cut, we run no ads and we own nothing you make. Every
            member and every project here is a file in a public code repository
            on GitHub — copy it, run your own version of the site, take the whole
            thing with you.
          </p>
          <p class="mark foot__licence">Free &amp; open source · MIT</p>
        </div>
      </div>
    </footer>

    <style>
      /* A carved beam across the top of the hall: timber, an iron-shod lower
         edge and a brass rail catching the candles. */
      .topbar {
        position: sticky;
        top: 0;
        z-index: 50;
        background-color: #2b1d11;
        background-image:
          radial-gradient(60% 180% at 12% 50%, rgba(255, 196, 112, 0.16), transparent 70%),
          radial-gradient(50% 160% at 78% 50%, rgba(255, 186, 104, 0.11), transparent 72%),
          repeating-linear-gradient(90deg,
            rgba(0,0,0,.22) 0 2px, transparent 2px 96px, rgba(0,0,0,.14) 96px 98px),
          repeating-linear-gradient(92deg,
            rgba(0,0,0,.1) 0 4px, transparent 4px 11px, rgba(255,214,160,.02) 11px 13px),
          linear-gradient(180deg, #3a2716 0%, #2b1d11 62%, #170f08 100%);
        border-bottom: 2px solid rgba(0, 0, 0, 0.7);
        /*
         * Two shadow states, because a beam with nothing beneath it has nothing
         * to cast onto. At the top of the page the deep cast read as a permanent
         * dark band under the header — a graphic device. It only becomes a
         * shadow once page content is actually passing underneath.
         */
        box-shadow:
          0 1px 0 rgba(240, 205, 133, 0.28) inset,
          0 3px 7px -3px rgba(0, 0, 0, 0.6),
          0 18px 34px -14px rgba(0, 0, 0, 0.9);
        transition: box-shadow 300ms cubic-bezier(.22, 1, .36, 1);
      }
      /* Absent JS the attribute is never set, so the cast shadow above stands. */
      .topbar[data-rest] {
        box-shadow:
          0 1px 0 rgba(240, 205, 133, 0.28) inset,
          0 4px 10px -8px rgba(0, 0, 0, 0.65);
      }
      .topbar::after {
        content: '';
        position: absolute;
        left: 0; right: 0; bottom: -2px;
        height: 2px;
        /* A catch of candlelight along the rail, not a printed rule: it fades
           out well before the ends so the beam reads as lit, not as bordered. */
        background: linear-gradient(90deg,
          transparent, rgba(192,138,52,.34) 18%, rgba(240,205,133,.72) 50%, rgba(192,138,52,.34) 82%, transparent);
      }
      .topbar__in {
        display: flex; align-items: center; justify-content: space-between;
        gap: 1.5rem; padding: 0.95rem 0;
      }
      .beam-mark { position: absolute; top: 0; left: 0; width: 1px; height: 1px; }

      .brand { display: inline-flex; align-items: center; gap: 0.7rem; text-decoration: none; color: var(--vellum); }
      .brand__shield { filter: drop-shadow(0 3px 7px rgba(0,0,0,.75)); }
      .brand__word {
        font-family: var(--carve); font-weight: 800; font-size: 1.04rem;
        letter-spacing: 0.19em; text-transform: uppercase;
        text-shadow: 0 2px 3px rgba(0,0,0,.8);
      }

      /*
       * The nav is carved, not recorded. Mono is this hall's voice for facts of
       * record — dates, counts, licences, code — and a way-sign on a beam is
       * signage, cut by the same hand that cut the wordmark. Cinzel one step
       * down in size and weight from the wordmark keeps the hierarchy.
       *
       * Colours are solid rather than vellum-at-an-alpha: the candle gradients
       * under the beam lift the ground from L=0.014 on bare timber to L=0.048
       * at the core of the pool, which costs about a third of the available
       * contrast — so each value is measured against that lit patch and not
       * against the timber. There: #d9cbae 6.7:1, --brass-lit (current page)
       * 7.1:1, #c7b795 (the out-link, smallest text on the beam) 5.5:1.
       */
      .nav { display: flex; align-items: center; gap: clamp(0.7rem, 2vw, 1.7rem); flex-wrap: wrap; }
      .nav__link {
        font-family: var(--carve); font-weight: 600;
        font-size: 0.78rem; letter-spacing: 0.12em;
        text-transform: uppercase; color: #d9cbae;
        text-decoration: none; padding: 0.34rem 0;
        border-bottom: 2px solid transparent; white-space: nowrap;
        text-shadow: 0 1px 2px rgba(0,0,0,.7);
        transition: color 160ms, border-color 160ms;
      }
      .nav__link:hover { color: var(--brass-hi); border-bottom-color: rgba(192,138,52,.65); }
      .nav__link[aria-current='page'] {
        color: var(--brass-lit);
        border-bottom-color: var(--brass);
        /* The current page is incised into the beam: a lit rail with the dark
           of the cut showing under it. */
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.55);
      }
      /*
       * The repository IS a fact of record, so it keeps mono — that is what
       * separates it from the three way-signs now that they are carved. It was
       * vellum at 0.38 alpha, which composites to about 2.6:1 on the beam.
       */
      .nav__link--out {
        font-family: var(--mark); font-weight: 500;
        font-size: 0.68rem; letter-spacing: 0.14em;
        color: #c7b795; border-bottom-width: 1px;
      }

      /*
       * A designed ring rather than the recoloured default. The beam is lit
       * unevenly, so brass alone cannot be relied on: the dark backing fills the
       * outline's offset and carries the 3:1 against whatever the timber is
       * doing at that point, and the brass carries the visibility.
       */
      .brand:focus-visible,
      .nav__link:focus-visible {
        outline: 2px solid var(--brass-lit);
        outline-offset: 4px;
        box-shadow: 0 0 0 7px rgba(13, 9, 6, 0.82);
        color: var(--brass-hi);
      }

      /* Reachable only by keyboard, and only until it is used. */
      .skip {
        position: fixed;
        top: 0; left: 50%;
        z-index: 70;
        transform: translate(-50%, -110%);
        padding: 0.62rem 1.3rem;
        font-family: var(--mark); font-size: 0.68rem;
        letter-spacing: 0.16em; text-transform: uppercase;
        color: #2a1c08; text-decoration: none;
        background: linear-gradient(180deg, var(--brass-lit), var(--brass));
        box-shadow: 0 10px 22px -10px rgba(0, 0, 0, 0.9);
        transition: transform 180ms cubic-bezier(.22, 1, .36, 1);
      }
      .skip:focus-visible {
        transform: translate(-50%, 0);
        /* Inside the plate: a brass ring on brass would be invisible. The ink
           is 5.5:1 on the darkest end of the gradient. */
        outline: 2px solid #2a1c08;
        outline-offset: -6px;
        /* Restated because the global focus ring paints its dark backing with
           box-shadow, and this plate's own lift would otherwise be replaced by
           it on whichever sheet happens to come last. */
        box-shadow: 0 10px 22px -10px rgba(0, 0, 0, 0.9);
      }

      /* The promise, on parchment nailed to the wall at the end of the hall.
         The .foot__oath class keeps its old name: the stylesheet is shared. */
      .foot { margin-top: clamp(4rem, 10vw, 8rem); padding: 0 0 4rem; }
      .foot__sheet {
        /* The sheet sets the measure, so the promise cannot outrun it: 62ch of
           sheet less its padding lands the text at ~57 real characters. */
        max-width: 62ch;
        margin-inline: auto;
        padding: 1.9rem 2.2rem 1.7rem;
        transform: rotate(-0.35deg);
      }
      /*
       * Left-ranged, not centred. Four lines of centred prose gives four
       * different left edges and no entry point for the eye — and this is the
       * one paragraph on the site that states what the site is for, so it is
       * set in full ink rather than the softer secondary tone.
       */
      .foot__oath {
        margin: 0.5rem 0 1.25rem;
        color: var(--ink);
        font-size: var(--f-body);
        line-height: 1.62;
        text-wrap: pretty;
      }
      /* --ink-faint is 4.4:1 on parchment, which does not clear AA at the
         0.71rem .mark size. */
      .foot__sheet p.mark { color: var(--ink-soft); }
      .foot__licence {
        margin: 0;
        padding-top: 0.85rem;
        border-top: 1px solid rgba(122, 88, 44, 0.32);
      }

      /* Cinzel sets wider than mono, so the beam runs out of room sooner. */
      @media (max-width: 1040px) {
        .nav { gap: clamp(0.6rem, 1.7vw, 1.1rem); }
        .nav__link { font-size: 0.73rem; letter-spacing: 0.09em; }
        .nav__link--out { font-size: 0.65rem; letter-spacing: 0.11em; }
      }
      /* The last stretch before the beam stacks is where the row is tightest —
         at 780px the wordmark and four way-signs are within a few pixels of
         wrapping the nav to a second line against a single-line brand. The
         wordmark gives up the space, since it is the one item here that is
         still legible a size down. */
      /* Bounded at the bottom as well as the top: below 760px the beam stacks,
         the brand gets a row to itself and the pressure this relieves is gone —
         so the shrink was still applying on phones for no reason. */
      @media (max-width: 880px) and (min-width: 761px) {
        .brand__word { font-size: 0.95rem; letter-spacing: 0.15em; }
        .nav { gap: 0.62rem; }
        .nav__link { font-size: 0.7rem; letter-spacing: 0.07em; }
        .nav__link--out { font-size: 0.63rem; letter-spacing: 0.09em; }
      }
      @media (max-width: 760px) {
        .topbar__in {
          flex-direction: column; align-items: flex-start;
          gap: 0.45rem; padding: 0.75rem 0 0.85rem;
        }
        .nav { row-gap: 0.1rem; }
        /* Stacked, the links are the tap targets rather than one row of text. */
        .nav__link { padding: 0.5rem 0; }
        .foot__sheet { padding: 1.6rem 1.5rem 1.4rem; }
      }
    </style>

    <script is:inline>
      // The beam's cast shadow belongs to whatever is passing under it, so it is
      // suppressed while the page is at rest at the top. IntersectionObserver on
      // a 1px mark at the document's origin, rather than a scroll listener.
      (function () {
        var beam = document.querySelector('.topbar');
        var mark = document.querySelector('.beam-mark');
        if (!beam || !mark || !('IntersectionObserver' in window)) return;
        // Measured rather than assumed: a page restored mid-scroll would
        // otherwise paint the resting shadow until the first callback lands.
        if (window.scrollY < 1) beam.setAttribute('data-rest', '');
        new IntersectionObserver(function (entries) {
          beam.toggleAttribute('data-rest', entries[0].isIntersecting);
        }).observe(mark);
      })();
    </script>
  </body>
</html>
