---
import { CHARGES, blazon, divisionPaths, hash } from '../lib/crest';

interface Props {
  handle: string;
  size?: number;
  overrides?: { field?: string; charge?: string; division?: string };
  title?: boolean;
}

const { handle, size = 64, overrides = {}, title = true } = Astro.props;
const arms = blazon(handle, overrides);
const halves = divisionPaths(arms.division);
// Stripping non-alphanumerics collided `foo-bar` with `foobar`, and the same
// member rendered twice on one page emitted duplicate clipPath ids — at which
// point every crest on the page resolves to whichever came first. Hashing the
// full props makes each instance's ids its own.
const id = `c${hash(handle + size + JSON.stringify(overrides)).toString(36)}`;
const shield = 'M3 3 H97 V56 C97 87 73 105 50 113 C27 105 3 87 3 56 Z';
---

<svg
  class="crest"
  viewBox="0 0 100 116"
  width={size}
  height={size * 1.16}
  role="img"
  aria-label={title ? `Crest of ${handle}: ${arms.text}` : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  <defs>
    <clipPath id={id}><path d={shield} /></clipPath>
    {halves && (
      <>
        <clipPath id={`${id}-h0`}><path d={halves[0]} /></clipPath>
        <clipPath id={`${id}-h1`}><path d={halves[1]} /></clipPath>
      </>
    )}
    <linearGradient id={`${id}-sheen`} x1="0" y1="0" x2="0.4" y2="1">
      <stop offset="0%" stop-color="#fff" stop-opacity="0.22" />
      <stop offset="45%" stop-color="#fff" stop-opacity="0.04" />
      <stop offset="100%" stop-color="#000" stop-opacity="0.26" />
    </linearGradient>
  </defs>

  <g clip-path={`url(#${id})`}>
    <rect width="100" height="116" fill={arms.field.hex} />
    {halves && <path d={halves[1]} fill={arms.second.hex} />}

    <!--
      Counterchanged: the charge is drawn twice, each pass clipped to one half
      and wearing that half's opposite tincture. It therefore contrasts on both
      sides by construction, which is what heraldry actually does — and is why
      the heavy keyline this used to need is gone. A plain field has no division
      to counterchange against, so it keeps a hairline to sit off the ground.
    -->
    {halves ? (
      <>
        <g clip-path={`url(#${id}-h0)`} fill={arms.second.hex} color={arms.second.hex}>
          <Fragment set:html={CHARGES[arms.charge]} />
        </g>
        <g clip-path={`url(#${id}-h1)`} fill={arms.field.hex} color={arms.field.hex}>
          <Fragment set:html={CHARGES[arms.charge]} />
        </g>
      </>
    ) : (
      <g
        fill={arms.chargeTincture.hex}
        color={arms.chargeTincture.hex}
        stroke="#171009"
        stroke-width="0.8"
        stroke-linejoin="round"
        style="paint-order: stroke fill"
      >
        <Fragment set:html={CHARGES[arms.charge]} />
      </g>
    )}

    {arms.bordure && (
      halves ? (
        <>
          <path d={shield} fill="none" stroke="#171009" stroke-width="13" opacity="0.85" />
          <path d={shield} fill="none" stroke={arms.second.hex} stroke-width="10"
                clip-path={`url(#${id}-h0)`} />
          <path d={shield} fill="none" stroke={arms.field.hex} stroke-width="10"
                clip-path={`url(#${id}-h1)`} />
        </>
      ) : (
        <path d={shield} fill="none" stroke={arms.second.hex} stroke-width="9" opacity="0.9" />
      )
    )}
    <rect width="100" height="116" fill={`url(#${id}-sheen)`} />
  </g>

  <path
    d={shield}
    fill="none"
    stroke="#c2913f"
    stroke-width="3"
    stroke-linejoin="round"
    opacity="0.85"
  />
</svg>

<style>
  .crest {
    display: block;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.55));
    flex: none;
  }
</style>
